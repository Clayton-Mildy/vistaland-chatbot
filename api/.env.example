# Postgres. The dev compose file serves both databases on 54329.
DATABASE_URL=postgresql://postgres:postgres@localhost:54329/vistaland
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:54329/vistaland_test

# Shared secret the dashboard sends as "Authorization: Bearer ...". At least 32 characters:
# openssl rand -hex 32
API_SECRET_KEY=

NODE_ENV=development
PORT=50060
LOG_LEVEL=info

# VLES integration (read-only). Empty VLES_API_KEY turns the sync off.
# The key in the keychain as vles-api-key-dev is a PRODUCTION key; the dev server rejects it.
VLES_BASE_URL=https://vles.vistalandapp.com/api/v1/integration
VLES_API_KEY=
VLES_SYNC_INTERVAL_MS=900000
VLES_MAX_REQ_PER_MIN=100

# Seed-only (scripts/seed.ts): the first dashboard admin, created when no staff exist yet.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin

# Uploaded materials. WhatsApp downloads them from PUBLIC_BASE_URL/media/<file>, so in production
# this must be the public https origin.
PUBLIC_BASE_URL=http://localhost:50060
MEDIA_DIR=./media

# ChakraHQ (WhatsApp). Webhook URL to register in ChakraHQ: https://<DOMAIN>/webhook (dev: a tunnel to :50060)
CHAKRA_PLUGIN_ID=
CHAKRA_ACCESS_TOKEN=
CHAKRA_WEBHOOK_SECRET=
CHAKRA_BASE_URL=https://api.chakrahq.com
CHAKRA_API_VERSION=v22.0
# Local testing only (NODE_ENV=development): accept unsigned webhooks.
SKIP_HMAC_IN_DEV=false

# Claude (Moni). Empty key: every turn is handed to staff instead of answered.
ANTHROPIC_API_KEY=
MONI_MODEL=claude-opus-5-5
MONI_EFFORT=medium

# Proxy hops in front of the API (production compose sets 1 for Caddy); 0 trusts none.
TRUST_PROXY_HOPS=0
# Per client IP, for public /media files. 0 turns the limit off.
MEDIA_RATE_LIMIT_PER_MIN=600
