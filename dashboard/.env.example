# NextAuth: openssl rand -base64 32
AUTH_SECRET=
# The dashboard's own public origin
AUTH_URL=http://localhost:40060
# Where this server reaches the API (server-side only; the browser never calls the API)
API_INTERNAL_URL=http://localhost:50060
# Must equal API_SECRET_KEY in api/.env
API_SECRET_KEY=
# How often a signed-in account is re-checked against the API (ms). Default 5 minutes.
# SESSION_RECHECK_MS=300000
