# Copy to deploy/.env (git-ignored) and fill in.

# Public hostname Caddy serves and gets a TLS certificate for (use "localhost" to rehearse locally).
DOMAIN=

# Postgres superuser password. Use URL-safe characters: openssl rand -hex 24
POSTGRES_PASSWORD=

# Shared secret between dashboard and API: openssl rand -hex 32
API_SECRET_KEY=
# NextAuth session secret: openssl rand -base64 32
AUTH_SECRET=

# VLES integration (read-only). Empty disables the sync.
# The keychain item "vles-api-key-dev" is a PRODUCTION key; the VLES dev server rejects it.
VLES_API_KEY=
VLES_SYNC_INTERVAL_MS=900000

# First dashboard admin, created by the seed only while no staff exist.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin

# ChakraHQ (WhatsApp). Webhook URL to register in ChakraHQ: https://<DOMAIN>/webhook
CHAKRA_PLUGIN_ID=
CHAKRA_ACCESS_TOKEN=
CHAKRA_WEBHOOK_SECRET=

# Claude (Moni). The API key always wins. Without one, a Claude account's OAuth token
# (from `claude setup-token`) is used instead. With neither, every turn is handed to staff.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
MONI_MODEL=claude-opus-5-5
MONI_EFFORT=medium

# Background jobs, in milliseconds. 0 turns a job off.
# How often due outbound WhatsApp template messages are sent.
OUTBOUND_POLL_MS=60000
# How often the notes of chats that went quiet are refreshed.
SUMMARY_REFRESH_MS=600000

# Requests per minute per client IP for the public /media files. 0 turns the limit off.
MEDIA_RATE_LIMIT_PER_MIN=600

# Web Push to staff. Generate the keys once: npx web-push generate-vapid-keys
# Push is off while either key is empty.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Must be a real mailto: or https: address (e.g. mailto:it@vistaland.id): Apple's push service
# rejects a localhost subject such as the built-in mailto:admin@localhost.
VAPID_SUBJECT=
